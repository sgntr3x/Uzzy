{
  "Cisco": {
    "global_config": "conf t",
    "interface": "interface GigabitEthernet 1/0/{port}",
    "interface_range": "interface range GigabitEthernet 1/0/{port}",
    "default_interface": "default interface GigabitEthernet 1/0/{port}",
    "default_interface_range": "default interface range GigabitEthernet 1/0/{port}",
    "end_command": "end",
    "exit_command": "exit",
    "vlan_create": {
      "create": "vlan {vlan_id}",
      "name": "name {vlan_name}",
      "interface": "interface vlan {vlan_id}",
      "ip_address": "ip address {ip} {mask}",
      "no_shutdown": "no shutdown"
    },
    "vlan_assign": {
      "access_mode": "switchport mode access",
      "access_vlan": "switchport access vlan {vlan_id}",
      "trunk_mode": "switchport mode trunk",
      "trunk_vlan": "switchport trunk allowed vlan {vlan_id}"
    },
    "stp": {
      "portfast": "spanning-tree portfast",
      "bpduguard": "spanning-tree bpduguard enable"
    },
    "poe": {
      "enable": "power inline auto",
      "disable": "power inline never"
    }
  },
